                Grid.Row="1"
                Margin="0,0,0,0"
                Orientation="Horizontal">
                <RadioButton Content="Quy trình 1" Style="{StaticResource RadioButtonAsButton}" />
                <RadioButton Content="Quy trình 1" Style="{StaticResource RadioButtonAsButton}" />
                <RadioButton Content="Quy trình 1" Style="{StaticResource RadioButtonAsButton}" />
