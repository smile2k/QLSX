<UserControl x:Class="QLSX.Module.Main.Views.CustomPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLSX.Module.Main.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderThickness="1" BorderBrush="Black" Padding="10">
        <StackPanel>
            <TextBlock Text="{Binding Message}" FontSize="16" TextAlignment="Center" Margin="10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="OK" Command="{Binding ConfirmCommand}" Width="80" Margin="5"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
